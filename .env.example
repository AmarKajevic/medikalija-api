PORT=5000
MONGODB_URL="mongodb+srv://<user>:<password>@<cluster>/<db>?appName=<app>"
# Ključ za potpis access tokena: najmanje 32 nasumična znaka (openssl rand -base64 48).
# Refresh tokeni više nisu JWT (nasumični, heš u bazi), pa JWT_REFRESH_SECRET nije potreban.
JWT_KEY="change-me"
# Adrese frontenda (zarez između više njih): CORS i zaštita osvežavanja sesije od tuđih sajtova
CORS_ORIGIN=http://localhost:5173

# Prijava grešaka (opciono): https://sentry.io → projekat Node → DSN
# SENTRY_DSN=

# Slanje pozivnica mejlom sa naloga doma (Gmail -> Bezbednost -> Lozinke za aplikacije)
# GMAIL_USER=dommedikalija@gmail.com
# GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"
# MAIL_FROM_NAME="Dom Medikalija"
